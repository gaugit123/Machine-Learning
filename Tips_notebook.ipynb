   "id": "ef0d2b32",
   "metadata": {},
   "outputs": [],
   "source": [
    "#One Hot Encoding\n",
    "preprocessor = ColumnTransformer([\n",
    "    ('cat_encoding', OneHotEncoder(drop='first', sparse_output=False, handle_unknown='ignore'),['sex','smoker','day','time']),\n",
    "    ('scale', StandardScaler(), ['total_bill', 'size'] )#The reason I only put total_bill and size in the StandardScaler is because they are the only original numerical input features in your dataset, else are categorical.\n",
    "],remainder='passthrough')"
